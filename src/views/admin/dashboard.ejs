<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Dashboard - Tritech Hub</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Roboto, -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(135deg, #f5f7fa 0%, #e9eef5 100%);
      min-height: 100vh;
      padding: 20px;
    }

    /* Main Container */
    .dashboard-container {
      max-width: 1400px;
      margin: 0 auto;
    }

    /* Profile Card - Top Right */
    .profile-section {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 30px;
    }

    .profile-card {
      background: white;
      border-radius: 20px;
      padding: 12px 24px 12px 16px;
      display: inline-flex;
      align-items: center;
      gap: 15px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
      transition: all 0.3s ease;
      border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .profile-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
    }

    .profile-avatar {
      width: 52px;
      height: 52px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      font-size: 22px;
      box-shadow: 0 4px 10px rgba(102, 126, 234, 0.3);
    }

    .profile-info {
      text-align: right;
    }

    .profile-name {
      font-size: 16px;
      font-weight: 700;
      color: #1a202c;
    }

    .profile-role {
      font-size: 12px;
      color: #718096;
      margin-top: 4px;
    }

    /* Section Titles */
    .section-title {
      font-size: 20px;
      font-weight: 600;
      color: #2d3748;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .section-title i {
      color: #667eea;
      font-size: 22px;
    }

    /* Stats Grid - 3 cards per row */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-bottom: 48px;
    }

    /* Individual Stat Card */
    .stat-card {
      background: white;
      border-radius: 24px;
      padding: 24px;
      display: flex;
      align-items: center;
      gap: 18px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
      transition: all 0.3s ease;
      cursor: pointer;
      border: 1px solid rgba(0, 0, 0, 0.04);
    }

    .stat-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    }

    .stat-icon {
      width: 65px;
      height: 65px;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
    }

    .stat-icon.blue {
      background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
      color: #4f46e5;
    }
    .stat-icon.green {
      background: linear-gradient(135deg, #d1fae5, #a7f3d0);
      color: #059669;
    }
    .stat-icon.red {
      background: linear-gradient(135deg, #fee2e2, #fecaca);
      color: #dc2626;
    }
    .stat-icon.orange {
      background: linear-gradient(135deg, #ffedd5, #fed7aa);
      color: #ea580c;
    }
    .stat-icon.purple {
      background: linear-gradient(135deg, #f3e8ff, #e9d5ff);
      color: #9333ea;
    }

    .stat-details {
      flex: 1;
    }

    .stat-number {
      font-size: 32px;
      font-weight: 800;
      color: #1e293b;
      line-height: 1.2;
    }

    .stat-label {
      font-size: 13px;
      font-weight: 600;
      color: #64748b;
      margin-top: 6px;
      letter-spacing: 0.3px;
    }

    /* Navigation Grid - 3 cards per row */
    .nav-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 20px;
    }

    /* Individual Nav Card */
    .nav-card {
      background: white;
      border-radius: 24px;
      padding: 32px 20px;
      text-align: center;
      text-decoration: none;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
      border: 1px solid rgba(0, 0, 0, 0.04);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      position: relative;
      overflow: hidden;
    }

    .nav-card::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #667eea, #764ba2);
      transform: scaleX(0);
      transition: transform 0.3s ease;
    }

    .nav-card:hover::before {
      transform: scaleX(1);
    }

    .nav-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 35px rgba(102, 126, 234, 0.2);
    }

    .nav-card i {
      font-size: 42px;
      background: linear-gradient(135deg, #667eea, #764ba2);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      transition: all 0.3s;
    }

    .nav-card:hover i {
      transform: scale(1.1);
      background: linear-gradient(135deg, #764ba2, #667eea);
      -webkit-background-clip: text;
      background-clip: text;
    }

    .nav-card span {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 1.2px;
      color: #2d3748;
    }

    .nav-card:hover span {
      color: #667eea;
    }

    /* Alert Styles */
    .alert {
      padding: 14px 20px;
      border-radius: 16px;
      margin-bottom: 28px;
      font-weight: 500;
      font-size: 14px;
    }
    .alert-error {
      background: #fef2f2;
      color: #b91c1c;
      border-left: 4px solid #ef4444;
    }
    .alert-success {
      background: #ecfdf5;
      color: #065f46;
      border-left: 4px solid #10b981;
    }

    /* ========== RESPONSIVE ========== */
    @media screen and (max-width: 950px) {
      .stats-grid {
        gap: 18px;
      }
      .nav-grid {
        gap: 18px;
      }
      .stat-card {
        padding: 18px;
      }
      .stat-icon {
        width: 55px;
        height: 55px;
        font-size: 26px;
      }
      .stat-number {
        font-size: 26px;
      }
    }

    @media screen and (max-width: 768px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
      }
      .nav-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
      }
      body {
        padding: 15px;
      }
      .profile-card {
        padding: 10px 18px 10px 12px;
      }
      .profile-avatar {
        width: 44px;
        height: 44px;
        font-size: 18px;
      }
      .nav-card {
        padding: 24px 16px;
      }
      .nav-card i {
        font-size: 34px;
      }
    }

    @media screen and (max-width: 550px) {
      .stats-grid {
        grid-template-columns: 1fr;
        gap: 14px;
      }
      .nav-grid {
        grid-template-columns: 1fr;
        gap: 14px;
      }
      .profile-section {
        justify-content: center;
      }
      .section-title {
        font-size: 18px;
        justify-content: center;
      }
      .stat-card {
        padding: 20px;
      }
      .nav-card {
        padding: 20px;
        flex-direction: row;
        justify-content: center;
        gap: 15px;
      }
      .nav-card i {
        font-size: 28px;
      }
    }
  </style>
</head>
<body>
<div class="dashboard-container">
  
  <!-- Profile Card - Top Right Corner -->
  <div class="profile-section">
    <div class="profile-card">
      <div class="profile-avatar">JD</div>
      <div class="profile-info">
        <div class="profile-name">John Doe</div>
        <div class="profile-role">Tenant Admin</div>
      </div>
    </div>
  </div>

  <!-- Alert Messages -->
  <div class="alert alert-success">
    <i class="fas fa-check-circle"></i> Welcome back, John! Your dashboard is ready.
  </div>

  <!-- Stats Section Title -->
  <div class="section-title">
    <i class="fas fa-chart-line"></i>
    <span>Statistics Overview</span>
  </div>

  <!-- STAT CARDS - 3 per row (6 cards total) -->
  <div class="stats-grid">
    <!-- Card 1: Total Staff -->
    <div class="stat-card">
      <div class="stat-icon blue">
        <i class="fas fa-user-tie"></i>
      </div>
      <div class="stat-details">
        <div class="stat-number">4</div>
        <div class="stat-label">Total Staff</div>
      </div>
    </div>

    <!-- Card 2: Total Customers -->
    <div class="stat-card">
      <div class="stat-icon green">
        <i class="fas fa-users"></i>
      </div>
      <div class="stat-details">
        <div class="stat-number">28</div>
        <div class="stat-label">Total Customers</div>
      </div>
    </div>

    <!-- Card 3: Total Devices -->
    <div class="stat-card">
      <div class="stat-icon purple">
        <i class="fas fa-mobile-alt"></i>
      </div>
      <div class="stat-details">
        <div class="stat-number">22</div>
        <div class="stat-label">Total Devices</div>
      </div>
    </div>

    <!-- Card 4: Overdue Payments -->
    <div class="stat-card">
      <div class="stat-icon red">
        <i class="fas fa-exclamation-circle"></i>
      </div>
      <div class="stat-details">
        <div class="stat-number">5</div>
        <div class="stat-label">Overdue Payments</div>
      </div>
    </div>

    <!-- Card 5: Locked Phones -->
    <div class="stat-card">
      <div class="stat-icon orange">
        <i class="fas fa-lock"></i>
      </div>
      <div class="stat-details">
        <div class="stat-number">2</div>
        <div class="stat-label">Locked Phones</div>
      </div>
    </div>

    <!-- Card 6: Active Plans -->
    <div class="stat-card">
      <div class="stat-icon green">
        <i class="fas fa-check-circle"></i>
      </div>
      <div class="stat-details">
        <div class="stat-number">20</div>
        <div class="stat-label">Active Plans</div>
      </div>
    </div>
  </div>

  <!-- Navigation Section Title -->
  <div class="section-title">
    <i class="fas fa-compass"></i>
    <span>Quick Navigation</span>
  </div>

  <!-- NAVIGATION CARDS - 3 per row (6 cards total) -->
  <div class="nav-grid">
    <a href="/admin/customers" class="nav-card">
      <i class="fas fa-users"></i>
      <span>CUSTOMERS</span>
    </a>
    <a href="/admin/staff" class="nav-card">
      <i class="fas fa-user-tie"></i>
      <span>STAFF</span>
    </a>
    <a href="/admin/devices" class="nav-card">
      <i class="fas fa-mobile-alt"></i>
      <span>DEVICES</span>
    </a>
    <a href="/admin/transactions" class="nav-card">
      <i class="fas fa-exchange-alt"></i>
      <span>TRANSACTIONS</span>
    </a>
    <a href="/admin/reports" class="nav-card">
      <i class="fas fa-chart-bar"></i>
      <span>REPORTS</span>
    </a>
    <a href="/admin/settings" class="nav-card">
      <i class="fas fa-cog"></i>
      <span>SETTINGS</span>
    </a>
  </div>
</div>
</body>
</html>

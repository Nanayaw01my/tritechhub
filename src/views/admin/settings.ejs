<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %><title>Settings - Tritech Hub</title></head>
<body>
<div class="layout">
  <%- include('../partials/admin-sidebar', {currentPage:'settings'}) %>
  <div class="main-content">
    <div class="topbar"><h1>Settings</h1></div>
    <div class="page-content">
      <div class="grid-2">
        <div class="card">
          <h3 style="margin-bottom:20px;font-size:15px;"><i class="fas fa-building"></i> Business Settings</h3>
          <div class="form-group"><label>Business Name</label><input type="text" value="Tritech Hub Accra"></div>
          <div class="form-group"><label>Email</label><input type="email" value="admin@tritechhub.com"></div>
          <div class="form-group"><label>Phone</label><input type="tel" value="055 000 0001"></div>
          <div class="form-group"><label>Address</label><input type="text" value="Accra, Ghana"></div>
          <button class="btn btn-primary"><i class="fas fa-save"></i> Save Changes</button>
        </div>
        <div class="card">
          <h3 style="margin-bottom:20px;font-size:15px;"><i class="fas fa-sliders-h"></i> Payment Settings</h3>
          <div class="form-group"><label>Grace Period (hours)</label><input type="number" value="48"></div>
          <div class="form-group"><label>Payment Period (months)</label><input type="number" value="6"></div>
          <div class="form-group"><label>Currency</label><select><option selected>GHS - Ghana Cedis</option></select></div>
          <div class="form-group"><label>Paystack Public Key</label><input type="text" placeholder="pk_live_..."></div>
          <button class="btn btn-primary"><i class="fas fa-save"></i> Save Settings</button>
        </div>
      </div>
    </div>
  </div>
</div>
</body></html>

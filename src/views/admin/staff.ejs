<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %><title>Staff - Tritech Hub</title></head>
<body>
<div class="layout">
 
  <div class="main-content">
    <div class="topbar">
      <h1>Staff Management</h1>
      <button class="btn btn-primary" onclick="document.getElementById('addStaffModal').style.display='flex'"><i class="fas fa-plus"></i> Add Staff</button>
    </div>
    <div class="page-content">
      <div class="card">
        <table>
          <thead><tr><th>Staff ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Customers</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody>
            <tr><td><strong>Tri001</strong></td><td>Kofi Adu</td><td>kofi@tenant.com</td><td>055 111 2222</td><td>12</td><td><span class="badge badge-success">Active</span></td><td><button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button></td></tr>
            <tr><td><strong>Tri002</strong></td><td>Ama Owusu</td><td>ama@tenant.com</td><td>024 333 4444</td><td>8</td><td><span class="badge badge-success">Active</span></td><td><button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button></td></tr>
            <tr><td><strong>Tri003</strong></td><td>Yaw Darko</td><td>yaw@tenant.com</td><td>020 555 6666</td><td>8</td><td><span class="badge badge-success">Active</span></td><td><button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<!-- Add Staff Modal -->
<div id="addStaffModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);align-items:center;justify-content:center;z-index:999;">
  <div class="card" style="width:100%;max-width:440px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <h3>Add New Staff</h3>
      <button onclick="document.getElementById('addStaffModal').style.display='none'" style="border:none;background:none;font-size:20px;cursor:pointer;">×</button>
    </div>
    <div class="form-group"><label>Full Name</label><input type="text" placeholder="Enter full name"></div>
    <div class="form-group"><label>Email</label><input type="email" placeholder="staff@email.com"></div>
    <div class="form-group"><label>Phone</label><input type="tel" placeholder="055 000 0000"></div>
    <div class="form-group"><label>Password (max 5 characters)</label><input type="password" placeholder="e.g. abc12" maxlength="5"></div>
    <div style="background:#f0f9f0;border-radius:8px;padding:12px;font-size:13px;color:var(--green);margin-bottom:16px;"><i class="fas fa-info-circle"></i> Staff ID will be auto-generated (e.g. Tri004)</div>
    <button class="btn btn-primary" style="width:100%;justify-content:center;"><i class="fas fa-plus"></i> Create Staff Account</button>
  </div>
</div>
</body></html>
